<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" onChange="OnLaunchArgsChanged" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x1E1F22FF" />
    <Label id="headerLabel" text="Rokord - Mobile Login Required" translation="[80, 50]" width="1760" height="60" />
    <Label id="loginNoticeLabel"
           text="REQUIRED: You must log in on the Rokord mobile app AND keep your phone and Roku on the SAME network connection to pair and sign in."
           translation="[80, 120]" width="1760" height="80" wrap="true" color="0xFAA61AFF" />
    <Label id="statusLabel" text="Status: Waiting for mobile app login on same connection." translation="[80, 215]" width="1760" height="50" />
    <LabelList id="channelList" translation="[80, 285]" width="520" height="680" />
    <Label id="messagesLabel" text="1. Open Rokord on your mobile device and sign in.&#10;2. Connect phone and Roku to the SAME Wi-Fi/LAN.&#10;3. Pair from the mobile app, then select Refresh Guilds."
           translation="[640, 285]" width="1200" height="680" wrap="true" />
  </children>
</component>
